---
import PageLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import Section from '@/components/Section.astro'

// Set proper 404 status code
Astro.response.status = 404
Astro.response.statusText = 'Not Found'

const meta = {
	description: 'Page not found. The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.',
	title: '404 - Page Not Found',
	ogImage: '/social-card.png',
	noindex: true // Flag to indicate this is a 404 page
}
---

<PageLayout meta={meta}>
	<Section class="flex flex-col items-center justify-center min-h-[60vh] text-center">
		<div class="space-y-6 max-w-2xl mx-auto px-4">
			<!-- 404 Error Message -->
			<div class="space-y-2">
				<h1 class="text-8xl font-bold text-foreground sm:text-9xl">404</h1>
				<h2 class="text-2xl font-semibold text-foreground sm:text-3xl">Page Not Found</h2>
			</div>
			
			<!-- Error Description -->
			<div class="space-y-2 text-muted-foreground">
				<p class="text-lg">Oops! The page you're looking for doesn't exist.</p>
				<p>It might have been moved, deleted, or the URL might be incorrect.</p>
			</div>
			
			<!-- Action Buttons -->
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
				<Button title='Go to Homepage' href='/' style='button'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='16'
						height='16'
						viewBox='0 0 24 24'
						slot='icon-before'
					>
						<path
							fill='currentColor'
							d='M10 20v-6h4v6h5v-8h3L12 3L2 12h3v8z'
						>
						</path>
					</svg>
				</Button>
				
				<Button title='View My Work' href='/#projects' style='secondary'>
					<svg
						xmlns='http://www.w3.org/2000/svg'
						width='16'
						height='16'
						viewBox='0 0 24 24'
						slot='icon-before'
					>
						<path
							fill='currentColor'
							d='M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z'
						>
						</path>
					</svg>
				</Button>
			</div>
			
			<!-- Helpful Links -->
			<div class="pt-8 border-t border-border">
				<p class="text-sm text-muted-foreground mb-4">Here are some helpful links:</p>
				<nav class="flex flex-wrap gap-4 justify-center text-sm">
					<a href="/" class="text-primary hover:underline">Home</a>
					<a href="/tools" class="text-primary hover:underline">Tools</a>
					<a href="/contact" class="text-primary hover:underline">Contact</a>
					<a href="/#projects" class="text-primary hover:underline">Projects</a>
					<a href="/#skills" class="text-primary hover:underline">Skills</a>
				</nav>
			</div>
		</div>
	</Section>
</PageLayout>
