---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { cn } from '@/utils'
import { Briefcase, GraduationCap } from "lucide-astro";

const {
	as: Tag = 'div',
	class: className,
	href,
	heading,
	subheading,
	date,
	icon,
	altText,
	imageClass
} = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif}')

---

<Tag
	class={cn(
		className,
		'relative rounded-2xl border border-border bg-primary-foreground px-5 py-3',
		href && 'transition-all hover:border-foreground/25 hover:shadow-sm'
	)}
	href={href}
>
	{ icon === 'briefcase' && <Briefcase class={cn('mb-3 md:absolute md:mb-0', imageClass)} /> }
	{ icon === 'graduation-cap' && <GraduationCap class={cn('mb-3 md:absolute md:mb-0', imageClass)} /> }
	<div class='flex flex-col gap-y-1.5'>
		<div class='flex flex-col gap-y-0.5'>
			<h2 class='text-lg font-medium'>{heading}</h2>
			<h3 class='text-muted-foreground'>{subheading}</h3>
			<h3 class='text-muted-foreground'>{date}</h3>
		</div>
		<slot />
	</div>
</Tag>
